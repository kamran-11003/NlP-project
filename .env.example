# Copy this file to .env and fill in your values.

# OpenAI (used only for writing SQL, clarification questions and the short explanation)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small

# PostgreSQL used by scripts/load_data.py to load the Olist data (optional)
POSTGRES_URL=postgresql://analyst:analyst@localhost:5433/olist

# Sources connected when the app starts: name=connection_string;name2=connection_string2
# Leave empty to use the local SQLite copies (data/olist.db, data/marketing.db).
DEFAULT_SOURCES=olist=postgresql://analyst:analyst@localhost:5433/olist;marketing=sqlite:///data/marketing.db

# Local speech models
WHISPER_MODEL=small.en
WHISPER_DEVICE=auto
# PIPER_VOICE=models/piper/en_US-lessac-medium.onnx

# Limits
MAX_REPAIRS=2
QUERY_TIMEOUT_S=20
TOP_TABLES=6
